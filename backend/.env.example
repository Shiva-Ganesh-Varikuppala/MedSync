# Copy the two NEW lines (JWT_*) into your real backend/.env. Never commit .env.
PORT=5001
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=medsync

# NEW - required by the authentication module.
# Make it long and random, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=60

# ---- Optional: use a cloud database (Azure Database for MySQL) -----------------
# Full guide: docs/AZURE_DATABASE.md
#DB_HOST=your-server-name.mysql.database.azure.com
#DB_PORT=3306
#DB_USER=medsyncadmin
#DB_SSL=true                 # Azure only accepts encrypted connections
#DB_TIMEZONE=+05:30          # Azure runs in UTC; this makes dates and reminders follow India time
#DB_SSL_CA=/path/to/ca.pem   # only if the certificate is not trusted automatically

# ---- Optional: send reminders and notices by email ----------------------------
# Leave SMTP_HOST out and everything stays inside the app.
# Gmail: smtp.gmail.com, port 587, user = your address, pass = an "App password".
# Needs:  npm install   (adds nodemailer)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false          # true only for port 465
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-app-password
#MAIL_FROM="MedSync <you@gmail.com>"

# ---- Optional: send reminders by SMS (Twilio). Needs all three. --------------
# Numbers without a country code are treated as DEFAULT_COUNTRY_CODE.
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=+1xxxxxxxxxx
#DEFAULT_COUNTRY_CODE=+91

# --- Uploaded files (prescription attachments) ---
# Leave empty to keep files in backend/uploads (development). Set to use Azure Blob Storage; see docs/AZURE_BLOB_STORAGE.md.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=prescription-files

# --- HTTPS (production, behind a TLS terminator such as Azure App Service) ---
# true: plain http requests are redirected to https and HSTS is sent. Leave unset for local development.
#FORCE_HTTPS=true
